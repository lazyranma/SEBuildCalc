# Solar Expanse Build Cost Calculator
# ====================================

PYTHON     := python

# GAME_DIR: path to Solar Expanse install.
# Override via env var SOLAR_EXPANSE_DIR or pass as make variable.
GAME_DIR   ?= $(or $(SOLAR_EXPANSE_DIR),)

DATA_DIR   := data
ICONS_DIR  := icons

# --- Intermediate outputs (generated by BepInEx plugin) ---
FACILITY_JSON   := $(DATA_DIR)/facility_costs.json
SPACECRAFT_JSON := $(DATA_DIR)/spacecraft_costs.json
LAUNCH_VEHICLE_JSON := $(DATA_DIR)/launch_vehicle_costs.json
LOC_NAMES_TXT   := $(DATA_DIR)/loc_names.txt
BUILDABILITY_JSON := $(DATA_DIR)/extracted_buildability.json
RESEARCH_JSON     := $(DATA_DIR)/research_unlocks.json

# --- Final output ---
HTML_OUT := index.html

.PHONY: all clean icons table help extract-run

# --- Default target: full pipeline ---
all: extract-run icons table

help:
	@echo "Solar Expanse Build Cost Calculator"
	@echo ""
	@echo "  extract-run  Build plugin, launch game, extract all data -> data/*"
	@echo "  icons        Extract resource icons from game assets -> icons/"
	@echo "  table        Generate HTML calculator -> index.html"
	@echo "  all          Full pipeline: extract-run + icons + table"
	@echo "  clean        Remove all generated files"
	@echo ""
	@echo "Typical workflow:"
	@echo "  make extract-run icons table"
	@echo ""
	@echo "Variables:"
	@echo "  GAME_DIR            Path to Solar Expanse install"
	@echo "  SOLAR_EXPANSE_DIR   Env var alternative to GAME_DIR"

# --- BepInEx plugin: build, deploy, run game, extract, kill ---
extract-run:
	$(PYTHON) extract/run_extract.py --game-dir "$(GAME_DIR)"

# --- Resource icons (Python, reads game assets) ---
# Uses a stamp file to avoid cyclic dependency (icons dir = target name)
ICONS_STAMP := $(ICONS_DIR)/.stamp

$(ICONS_STAMP): extract_icons.py
	@echo "[*] Extracting resource icons..."
	$(PYTHON) extract_icons.py --game-dir "$(GAME_DIR)"
	@touch "$(ICONS_STAMP)"

icons: $(ICONS_STAMP)

# --- HTML table ---
$(HTML_OUT): generate_table.py $(FACILITY_JSON) $(SPACECRAFT_JSON) $(LAUNCH_VEHICLE_JSON) $(ICONS_STAMP) $(LOC_NAMES_TXT) $(BUILDABILITY_JSON) $(RESEARCH_JSON)
	@echo "[*] Generating HTML build cost calculator..."
	$(PYTHON) generate_table.py

table: $(HTML_OUT)

# --- Clean ---
clean:
	@echo "[*] Cleaning generated files..."
	-@rm -f "$(HTML_OUT)"
	-@rm -f "$(FACILITY_JSON)"
	-@rm -f "$(SPACECRAFT_JSON)"
	-@rm -f "$(LAUNCH_VEHICLE_JSON)"
	-@rm -f "$(LOC_NAMES_TXT)"
	-@rm -f "$(BUILDABILITY_JSON)"
	-@rm -f "$(RESEARCH_JSON)"
	-@rm -f "$(ICONS_STAMP)"
	-@rm -rf "$(ICONS_DIR)"
	-@rm -rf extract/bin extract/obj
